#!/usr/bin/env bash
# Pre-push gate: when outgoing commits touch backend/**, run the workspace
# tests and the baseline-vs-head engine benchmark. New bench result files are
# committed on their own and the branch is re-pushed automatically - the
# original (then stale) push is aborted on purpose, because git resolves the
# pushed SHA before this hook runs.
#
# Env knobs:
#   BENCH_RUNS=N            timed runs per binary per case (default: 3)
#   RUN_CRITERION=1         additionally run the criterion benches
#   BENCH_HOOK_SKIP_TESTS=1 skip `cargo test` (benches only)
#   BENCH_HOOK_DRY_RUN=1    do everything except commit + re-push
#   SKIP_BENCH_PUSH=1       bypass this hook entirely (set by the re-push)
set -u

ZERO="0000000000000000000000000000000000000000"
[ -n "${SKIP_BENCH_PUSH:-}" ] && exit 0

remote="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- does any outgoing commit touch backend/** ? ----------------------------
touches_backend=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue # ref deletion
    if [ "$remote_sha" = "$ZERO" ]; then
        # new branch: everything not already on the remote
        if git remote | grep -qx "$remote"; then
            range="$local_sha --not --remotes=$remote"
        else
            range="$local_sha"
        fi
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    if git rev-list $range -- backend/ 2>/dev/null | grep -q .; then
        touches_backend=1
    fi
done
[ "$touches_backend" -eq 0 ] && exit 0

echo "pre-push: outgoing commits touch backend/ - running tests + benches"

# --- gate: tests, then benches (failure aborts the push, commits nothing) ---
if [ -z "${BENCH_HOOK_SKIP_TESTS:-}" ]; then
    cargo test --workspace --manifest-path backend/Cargo.toml \
        || { echo "pre-push: cargo test failed - push aborted"; exit 1; }
fi

RUNS="${BENCH_RUNS:-3}" backend/scripts/bench/compare_engines.sh \
    || { echo "pre-push: benchmark failed - push aborted"; exit 1; }

if [ -n "${RUN_CRITERION:-}" ]; then
    cargo bench --manifest-path backend/Cargo.toml -p craftpath-core --bench engine_benches \
        || { echo "pre-push: criterion bench failed - push aborted"; exit 1; }
fi

# --- commit new results + re-push -------------------------------------------
if [ -z "$(git status --porcelain -- backend/benches/results)" ]; then
    echo "pre-push: bench results unchanged - push continues"
    exit 0
fi

branch="$(git symbolic-ref -q --short HEAD)" || {
    echo "pre-push: detached HEAD - bench results left uncommitted, push continues"
    exit 0
}

if [ -n "${BENCH_HOOK_DRY_RUN:-}" ]; then
    echo "pre-push: DRY RUN - would commit backend/benches/results and re-push '$branch' to '$remote'"
    exit 1
fi

short_head="$(git rev-parse --short HEAD)"
git add backend/benches/results
# pathspec-limited: never sweeps up unrelated staged work
git commit -m "test(core): :chart_with_upwards_trend: record bench results for $short_head vs ${BASELINE_REF:-0.5.1}" \
    -- backend/benches/results \
    || { echo "pre-push: result commit failed - push aborted"; exit 1; }

SKIP_BENCH_PUSH=1 git push "$remote" "$branch" \
    || { echo "pre-push: re-push failed - results are committed, push manually"; exit 1; }

echo "pre-push: bench results committed and pushed."
echo "pre-push: the original push is aborted on purpose (it pointed at the pre-result commit)."
exit 1
